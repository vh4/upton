# Upton - Environment Configuration Example

# Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Direct PostgreSQL Connection URL (Local or Remote)
DATABASE_URL=

# Supabase Configuration (PostgreSQL & Supabase Storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Hybrid Storage Configuration:
# - Leave blank to auto-detect: on Vercel uses Supabase Storage ('upton-files'), on laptop uses local folder (./file)
# - Set to 'supabase' to force Supabase Storage everywhere
# - Set to 'local' to force local filesystem everywhere
STORAGE_DRIVER=
SUPABASE_STORAGE_BUCKET=upton-files

# File Upload Limits (in Megabytes)
MAX_FILE_SIZE_MB=500

# Local Upload Directory (used when STORAGE_DRIVER is local)
UPLOAD_DIR=./file

# Cleanup API Authorization Secret
CRON_SECRET=

# Admin Storage Reset Authentication (used for /reset route)
ADMIN_RESET_USER=tony
ADMIN_RESET_PASS=Upton@2026

