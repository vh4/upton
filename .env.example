# Upton - Environment Configuration Example

# Public App URL (us
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Direct PostgreSQL Connection URL (Local or Remote)
DATABASE_URL=

# Supabase PostgreSQL Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# File Upload Limits
MAX_FILE_SIZE_MB=500

# Local Upload Directory (relative or absolute)
UPLOAD_DIR=./file

# Cleanup API Authorization Secret
CRON_SECRET=
